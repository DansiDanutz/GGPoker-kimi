{
  "name": "ggpoker-playmoney",
  "version": "1.0.0",
  "private": true,
  "description": "Offline play-chip poker and casino app for macOS",
  "type": "commonjs",
  "scripts": {
    "dev": "python3 -m http.server 4173 --directory src",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/ui-qa.cjs",
    "test:formats": "node tests/formats-qa.cjs",
    "test:redesign": "node tests/redesign-qa.cjs",
    "verify:ui": "npm run test:ui && npm run test:formats && npm run test:redesign",
    "build": "bash native/build.sh",
    "verify": "npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
